-- Variables for the multi-door mechanic
local reboundsRemaining = math.random(4, 5) 
local isSpawning = false
local showEffects = true -- Flag to control the light effects

-- Function to handle the Visuals and Sound
local function playEffects()
    if not showEffects then return end
    
    local Reboundcolor = Instance.new("ColorCorrectionEffect", game.Lighting)
    game.Debris:AddItem(Reboundcolor, 24)
    Reboundcolor.Name = "Warn"
    Reboundcolor.TintColor = Color3.fromRGB(65, 138, 255)
    Reboundcolor.Saturation = -0.7
    Reboundcolor.Contrast = 0.2
    
    game.TweenService:Create(Reboundcolor, TweenInfo.new(15), {
        TintColor = Color3.fromRGB(255, 255, 255),
        Saturation = 0,
        Contrast = 0
    }):Play()

    -- Camera Shake
    local CameraShaker = require(ReplicatedStorage.CameraShaker)
    local camara = workspace.CurrentCamera
    local camShake = CameraShaker.new(Enum.RenderPriority.Camera.Value, function(shakeCf)
        camara.CFrame = camara.CFrame * shakeCf
    end)
    camShake:Start()
    camShake:ShakeOnce(10, 3, 0.1, 6, 2, 0.5)
    
    showEffects = false 
end

-- Function to Spawning the Entity
local function spawnRebound()
    if isSpawning then return end
    isSpawning = true
    
    playEffects()
    
    local spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"))()

