<script>
(function(){
  var c=document.getElementById('particles');
  if(!c)return;
  var ctx=c.getContext('2d');
  var w,h,dots=[],mx=-1e3,my=-1e3,MR=150;
  var cs=getComputedStyle(document.documentElement);
  var tH=cs.getPropertyValue('--hue').trim()||'344';
  var tS=cs.getPropertyValue('--sat').trim()||'100';
  var tL=cs.getPropertyValue('--light').trim()||'50';
  function hsl(a){return 'hsla('+tH+','+tS+'%,'+tL+'%,'+a+')';}
  function resize(){w=c.width=innerWidth;h=c.height=innerHeight}
  function init(){resize();dots=[];var n=Math.min(Math.floor(w*h/6e3),120);for(var i=0;i<n;i++)dots.push({x:Math.random()*w,y:Math.random()*h,ox:0,oy:0,r:Math.random()*1.8+.4,dx:(Math.random()-.5)*.25,dy:(Math.random()-.5)*.25,o:Math.random()*.5+.15})}
  function draw(){ctx.clearRect(0,0,w,h);for(var i=0;i<dots.length;i++){var d=dots[i];d.x+=d.dx;d.y+=d.dy;if(d.x<0)d.x=w;if(d.x>w)d.x=0;if(d.y<0)d.y=h;if(d.y>h)d.y=0;var dx=d.x-mx,dy=d.y-my,dist=Math.sqrt(dx*dx+dy*dy);if(dist<MR){var f=(MR-dist)/MR;d.ox+=dx/dist*f*2;d.oy+=dy/dist*f*2}d.ox*=.92;d.oy*=.92;var px=d.x+d.ox,py=d.y+d.oy,mD=Math.sqrt((px-mx)**2+(py-my)**2),gB=mD<MR*1.5?(1-mD/(MR*1.5))*.6:0;ctx.beginPath();ctx.arc(px,py,d.r+gB*2,0,Math.PI*2);ctx.fillStyle=hsl(d.o+gB);ctx.fill()}requestAnimationFrame(draw)}
  addEventListener('mousemove',function(e){mx=e.clientX;my=e.clientY});
  addEventListener('mouseleave',function(){mx=-1e3;my=-1e3});
  addEventListener('resize',resize);init();draw()
})();
</script>
